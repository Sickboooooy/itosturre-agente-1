# OpenNotebook v2.0 — Configuración via .env
# Copiar a .env en el mismo directorio que OpenNotebook_v2.0.py
# Las rutas usan defaults si no está el archivo .env

# Ruta a la base vectorial ChromaDB
CHROMA_PATH=/home/licjo/chroma_db

# Ruta al corpus local de jurisprudencia (tesis JSON)
JURISPRUDENCIA_PATH=/home/licjo/jurisprudencia

# Umbral de distancia coseno (0.0 - 1.0)
# 0.50 = conservador (recomendado para legal mexicano)
# 0.40 = muy estricto (menos falsos positivos, más falsos negativos)
# 0.60+ = permisivo (más falsos positivos)
COSINE_THRESHOLD=0.50
