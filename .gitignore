# Worktrees aislados que crean los agentes de Claude Code
.claude/worktrees/
*.log
temp/
debug/

# ChromaDB
chroma_db/
.chroma/

# Jurisprudencia (datos pesados — correcciones VVCA y caché de tesis)
jurisprudencia/

# Corpus (too large — use Google Drive link)
corpus/*.pdf

# Auditorías: work product con datos personales/de cliente — NO versionar
auditorias/

# Reportes de vigencia del corpus (scripts/vigencia_corpus.py): estado local de la agenda
# bimestral, se regeneran en cada corrida. Las descargas del cotejo viven fuera del repo
# (~/itosturre-data/cotejo/).
/reportes/

# Prospectos B2B reales, consentimientos y listas de exclusión — sólo local
leads_data/

# Salida de los watchers de vigilancia normativa (agentes/vigilancia_dof.py,
# vigilancia_jurisprudencial.py, contenido_linkedin.py): briefs, contratos .json,
# estados de corrida y el log de eventos. Regenerable y con borradores de
# contenido pendientes de revisión — no es código, no se versiona. Ver
# docs/VIGILANCIA_LEGAL.md. NUNCA ignorar aquí "Itosturre/": en macOS y Windows
# (core.ignorecase=true) esa regla también ignora el paquete itosturre/ y todo
# módulo nuevo quedaría fuera del repo (tests/test_vigilancia_rutina.py lo vigila).
/salidas/

# Memoria contextual: por defecto vive FUERA del repo (~/.itosturre/memoria/).
# Estas reglas son red de seguridad por si ITOSTURRE_MEMORIA_DIR se reapunta
# hacia dentro del árbol: contiene decisiones y notas del despacho.
# Anclada con '/' inicial: sin ella la regla también ignoraría el paquete de
# código itosturre/memoria/, que sí debe versionarse.
/memoria/
*.db
*.db-wal
*.db-shm

# Backups locales
*.bak

# Casos con datos de cliente real — NO versionar (regla #8 CLAUDE.md)
casos_de_prueba/*aaron*
casos_de_prueba/*Aaron*

# Mapa de conocimiento graphify (regenerable, pesado) — ver docs/plan-organizacion-repo.md
graphify-out/

# Repos embebidos ajenos al auditor legal (proyectos separados, cada uno con su
# propio .git) — P0 del plan de organización. NO son producto; se gitignoran para
# quitar el ruido de `git status` y evitar que `git add -A` los arrastre.
# itosturre-scraper (submódulo) e itosturre-skills (producto) NO van aquí.
services/cfdi-gen/
services/itosturre-wa/
services/bridge-whatsapp/
services/linkedin-prospector/
services/notion/
