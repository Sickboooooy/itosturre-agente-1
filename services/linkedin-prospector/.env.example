# Copia a .env y rellena
ANTHROPIC_API_KEY=

# Modelo Claude para conducir el navegador
CLAUDE_MODEL=claude-sonnet-4-0

# Nombre de la carpeta del perfil de Chrome con tu sesión de LinkedIn iniciada.
# Déjalo vacío para que el script te liste los perfiles y elijas.
CHROME_PROFILE=

# Cuántos perfiles revisar por término y tope de pasos del agente
N_PERFILES=10
MAX_STEPS=40
